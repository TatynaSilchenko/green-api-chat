# Скопируйте в .env и заполните. Сам .env в git не коммитится.

# --- Приложение -------------------------------------------------------------
# Хост GREEN-API (apiUrl из консоли инстанса)
VITE_API_URL=https://api.green-api.com

# --- Ручная проверка API через curl (без VITE_, в сборку не попадают) ------
# Данные инстанса из console.green-api.com
API=https://api.green-api.com
ID=
TOKEN=
# Номер аккаунта-отправителя, только цифры
MY_PHONE=
# Номер собеседника, только цифры
PEER_PHONE=
# chatId собеседника (ответ checkAccount)
PEER_CHAT=
